@echo off\nREM Socket.io Vercel Fix Verification Script (Windows)\nREM This script verifies that the Socket.io polling transport is properly configured\n\nsetlocal enabledelayedexpansion\n\necho.\necho =============================================================\necho   Socket.io Vercel Fix - Verification Script\necho =============================================================\necho.\n\nset CHECKS=0\nset ISSUES=0\n\nREM Function to check if text exists in file\nREM Usage: call :check_file file_path search_text description\n\necho Checking server configuration...\necho.\n\nREM Check 1: File exists\nif exist \"backend\\server.js\" (\n  echo [OK] backend\\server.js exists\n  set /A CHECKS+=1\n) else (\n  echo [ERROR] backend\\server.js not found\n  set /A CHECKS+=1\n  set /A ISSUES+=1\n)\n\necho.\necho Checking Socket.io configuration...\necho.\n\nREM Check 2: transports configured\nfindstr /M \"transports.*polling\" \"backend\\server.js\" >nul 2>&1\nif errorlevel 1 (\n  echo [ERROR] transports: ['polling'] not found\n  set /A ISSUES+=1\n) else (\n  echo [OK] transports: ['polling'] configured\n)\nset /A CHECKS+=1\n\nREM Check 3: allowUpgrades disabled\nfindstr /M \"allowUpgrades.*false\" \"backend\\server.js\" >nul 2>&1\nif errorlevel 1 (\n  echo [ERROR] allowUpgrades: false not found\n  set /A ISSUES+=1\n) else (\n  echo [OK] allowUpgrades: false is set\n)\nset /A CHECKS+=1\n\nREM Check 4: pollInterval configured\nfindstr /M \"pollInterval\" \"backend\\server.js\" >nul 2>&1\nif errorlevel 1 (\n  echo [ERROR] pollInterval not configured\n  set /A ISSUES+=1\n) else (\n  echo [OK] pollInterval configured\n)\nset /A CHECKS+=1\n\nREM Check 5: CORS configured\nfindstr /M \"cors:\" \"backend\\server.js\" >nul 2>&1\nif errorlevel 1 (\n  echo [ERROR] CORS configuration missing\n  set /A ISSUES+=1\n) else (\n  echo [OK] CORS configuration present\n)\nset /A CHECKS+=1\n\necho.\necho Checking client configuration...\necho.\n\nREM Check 6: Flutter client - incoming_orders_screen\nfindstr /M \"'transports': \\['polling'\\]\" \"lib\\screens\\incoming_orders_screen.dart\" >nul 2>&1\nif errorlevel 1 (\n  echo [ERROR] incoming_orders_screen.dart not properly configured\n  set /A ISSUES+=1\n) else (\n  echo [OK] incoming_orders_screen.dart uses polling transport\n)\nset /A CHECKS+=1\n\nREM Check 7: Flutter client - order_notification_service\nfindstr /M \"'transports': \\['polling'\\]\" \"lib\\services\\order_notification_service.dart\" >nul 2>&1\nif errorlevel 1 (\n  echo [ERROR] order_notification_service.dart not properly configured\n  set /A ISSUES+=1\n) else (\n  echo [OK] order_notification_service.dart uses polling transport\n)\nset /A CHECKS+=1\n\nREM Check 8: upgrade disabled\nfindstr /M \"'upgrade': false\" \"lib\\services\\order_notification_service.dart\" >nul 2>&1\nif errorlevel 1 (\n  echo [ERROR] Client 'upgrade': false not found\n  set /A ISSUES+=1\n) else (\n  echo [OK] Client has 'upgrade': false set\n)\nset /A CHECKS+=1\n\necho.\necho Checking error handling...\necho.\n\nREM Check 9: Error handlers\nfindstr /M \"onConnect_error\" \"lib\\screens\\incoming_orders_screen.dart\" >nul 2>&1\nif errorlevel 1 (\n  echo [ERROR] Connection error handlers not found\n  set /A ISSUES+=1\n) else (\n  echo [OK] Connection error handlers present\n)\nset /A CHECKS+=1\n\nREM Check 10: Socket logging\nfindstr /M \"Socket connected\" \"backend\\server.js\" >nul 2>&1\nif errorlevel 1 (\n  echo [ERROR] Socket connection logging not found\n  set /A ISSUES+=1\n) else (\n  echo [OK] Socket connection logging enabled\n)\nset /A CHECKS+=1\n\necho.\necho =============================================================\necho Verification Results\necho =============================================================\necho.\n\nif %ISSUES% equ 0 (\n  echo [OK] All %CHECKS% checks passed! Socket.io fix is properly configured.\n  echo.\n  echo Next steps:\n  echo   1. cd backend\n  echo   2. npm install (if needed)\n  echo   3. node server.js (start backend)\n  echo   4. Open http://localhost:4000 in browser\n  echo   5. Use DevTools console to test socket connection\n  echo.\necho.\necho Instructions:\necho   1. Open DevTools Console (F12)\necho   2. Paste this code:\necho.\necho   const socket = io('http://localhost:4000', {\necho     transports: ['polling'],\necho     upgrade: false\necho   });\necho   socket.on('connect', () => console.log('Connected!'));\necho   socket.on('error', e => console.log('Error:', e));\necho.\necho   3. If you see 'Connected!' the fix is working\necho.) else (\n  echo [ERROR] %ISSUES% out of %CHECKS% checks failed\n  echo.\n  echo Please review the errors above and fix the configuration.\n  echo See SOCKET_IO_VERCEL_FIX.md for detailed instructions.\necho.)\n\necho =============================================================\necho.\n\nendlocal\n"